{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行用例 main.py (pytest_api / test)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": ["--project", "pytest_api", "--env", "test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "ENV": "test"
      }
    },
    {
      "name": "元素表体检 --check-elements",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": ["--check-elements"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
